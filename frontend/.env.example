# VitalSync AI - Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Mapbox Access Token (required for live maps on /doctor, /hospital, /ambulance)
# Get your token at https://account.mapbox.com/
VITE_MAPBOX_TOKEN=

# Firebase Configuration (required for real-time cross-dashboard sync)
# Get these from your Firebase console > Project Settings > Your apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_DATABASE_URL=
